{
  "name": "appLS",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "TS_NODE_TRANSPILE_ONLY=1 node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' ./bin/www.ts",
    "build": "tsc",
    "dev": "TS_NODE_TRANSPILE_ONLY=1 node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' ./bin/www.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns='.*\\.integration\\.test\\.ts$'",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/*.integration.test.ts'",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --testPathIgnorePatterns='.*\\.integration\\.test\\.ts$'",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathIgnorePatterns='.*\\.integration\\.test\\.ts$'",
    "generate-certs": "TS_NODE_TRANSPILE_ONLY=1 node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' scripts/generateCerts.ts",
    "import:pays": "npx ts-node --esm scripts/importPays.ts",
    "import:villes": "npx ts-node --esm scripts/importVilles.ts",
    "import:aeroports": "npx ts-node --esm scripts/importAeroports.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.2",
    "@types/cors": "^2.8.19",
    "@types/libsodium-wrappers": "^0.7.14",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "debug": "^4.3.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-errors": "^2.0.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.23",
    "libsodium-wrappers": "^0.7.15",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pug": "^3.0.2",
    "sequelize": "^6.37.7",
    "stripe": "^19.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.6",
    "@types/node": "^24.6.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
