# ============================================================================
# CONFIGURATION BASE DE DONNÉES
# ============================================================================

# Nom de la base de données PostgreSQL
DB_NAME=nom_de_la_base

# Utilisateur PostgreSQL
DB_USER=utilisateur

# Mot de passe PostgreSQL
DB_PASSWORD=mot_de_passe

# Hôte de la base de données (localhost pour développement local)
DB_HOST=localhost

# Port PostgreSQL (5432 par défaut)
DB_PORT=5432


# ============================================================================
# CONFIGURATION SERVEUR
# ============================================================================

# Port sur lequel le serveur Express écoute
PORT=3000

# Environnement (development, production, test)
NODE_ENV=development


# ============================================================================
# SÉCURITÉ & AUTHENTIFICATION
# ============================================================================

# Secret pour signer les tokens JWT (IMPORTANT: Utiliser une valeur aléatoire longue et complexe)
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire

# Durée de validité des tokens JWT (ex: 1h, 24h, 7d)
JWT_EXPIRATION=24h


# ============================================================================
# API EXTERNES
# ============================================================================

# Clé API AirLabs pour l'import des pays
# Obtenir sur: https://airlabs.co/
AIRLABS_API_KEY=votre_cle_api_airlabs


# ============================================================================
# FRONTEND
# ============================================================================

# URL du frontend pour la configuration CORS
# En développement: http://localhost:3001
# En production: https://votre-domaine.com
FRONTEND_URL=http://localhost:3001


# ============================================================================
# LOGGING
# ============================================================================

# Niveau de log (error, warn, info, debug)
LOG_LEVEL=info
